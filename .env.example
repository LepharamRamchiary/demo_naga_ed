# Copy this file to .env for Docker Compose and replace the example values.
# Never commit .env or put real credentials in this template.

# Groq credentials for AI username suggestions
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Backend and allowed browser origin
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:8080

# MySQL credentials
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=naga_ed

# Use a long, unique random value in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
